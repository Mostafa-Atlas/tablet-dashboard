PORT=1200
APP_TIMEZONE=Africa/Cairo
# 6th of October City, Giza
WEATHER_LAT=29.9668
WEATHER_LON=30.9333
DATA_DIR=./data
# Exact source IP permitted to POST PC stats and Now Playing (actual socket peer).
