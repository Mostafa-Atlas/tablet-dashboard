# Copy to agent/.env. Loaded at startup; real process/service variables win.
# SERVER is the dashboard address, not the reporting PC's address.
# Configure the server's PC_ALLOW_IP to this machine's actual socket-peer IP.
SERVER=http://192.168.50.1:1200
INTERVAL=2
# Optional Windows SMTC on supported Python; set 0 for telemetry only.
MEDIA_ENABLED=1
